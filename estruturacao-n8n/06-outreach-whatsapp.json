        "url": "https://graph.facebook.com/v19.0/SUBSTITUIR-PHONE-NUMBER-ID/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ messaging_product: 'whatsapp', to: $json.telefone, type: 'text', text: { body: $json._msg_outreach } }) }}",
        "options": {}
      },
