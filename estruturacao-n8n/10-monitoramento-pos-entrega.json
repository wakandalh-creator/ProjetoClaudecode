    {
      "parameters": {
        "jsCode": "// TODO: Search Console (indexação/erros) e Google Business Profile (avaliações novas) ainda não têm chamada real aqui —\n// ambos exigem OAuth por propriedade/negócio, não uma API key simples. Ligar quando essas contas forem criadas por cliente.\nconst item = $input.item.json;\nconst score = ((item.lighthouseResult && item.lighthouseResult.categories && item.lighthouseResult.categories.performance && item.lighthouseResult.categories.performance.score) || 0) * 100;\nitem.performance_score = score;\nitem.abaixo_da_meta = score < 90; // meta do Portfólio v3.0: Core Web Vitals 90+\nreturn { json: item };"
