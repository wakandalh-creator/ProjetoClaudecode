    {
      "parameters": {
        "jsCode": "// Score 0-10 em 5 critérios (2 pontos cada) — ver \"Piloto — Salões e Barbearias JF\" no vault.\n// Critérios sugeridos (ajustar com dados reais depois do piloto):\n// 1. Nota Google >= 4.0\n// 2. Tem >= 20 avaliações no Google\n// 3. Instagram com >= 500 seguidores OU postagem nos últimos 30 dias\n// 4. Telefone/WhatsApp válido e verificável\n// 5. Domínio de marca disponível (checado só no Checkpoint 1, não aqui)\nconst item = $input.item.json;\nlet score = 0;\nif ((item.nota_google || 0) >= 4.0) score += 2;\nif ((item.avaliacoes_google || []).length >= 20) score += 2;\nif (item.instagram_ativo) score += 2;\nif (item.telefone_valido) score += 2;\nscore += 2; // placeholder pro critério 5 até existir checagem real de domínio aqui\nitem.score_triagem = score;\nitem.caminho = item.site_atual && item.site_atual.trim() !== '' ? 'B' : 'A';\nreturn { json: item };"
      },
      "id": "a1111111-1111-4111-8111-111111111105",
      "name": "Calcular score de triagem",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -540,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-score",
              "leftValue": "={{ $json.score_triagem }}",
              "rightValue": 6,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
